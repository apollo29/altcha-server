# Pflicht: derselbe Schlüssel wie im Redaxo-Modul M20, Feld «HMAC-Schlüssel»
# (REX_VALUE[16]). Erzeugen mit:  openssl rand -hex 32
ALTCHA_HMAC_KEY=

# Domains, die das Widget einbinden dürfen (kommagetrennt, Schema mitschreiben).
# Leer oder * erlaubt jede Herkunft.
ALTCHA_ALLOWED_ORIGINS=https://www.fclaenggasse.ch,https://fclaenggasse.ch

# Gültigkeitsdauer einer Challenge in Sekunden (30-3600, Standard 300).
# Kurz halten: so lange bleibt eine abgefangene Lösung brauchbar.
ALTCHA_EXPIRES=300

# Rechenaufwand für den Browser (1000-1000000, Standard 50000).
ALTCHA_MAX_NUMBER=50000

# SHA-256 (Standard) oder SHA-512.
ALTCHA_ALGORITHM=SHA-256

# Nur setzen, wenn der Dienst in einem Unterverzeichnis liegt, z. B. /altcha
ALTCHA_BASE_PATH=

# Fehlermeldungen im Klartext ausgeben - nur zur Fehlersuche.
ALTCHA_DEBUG=false
