{
    "name": "apollo29/altcha-server",
    "description": "Selbst gehosteter ALTCHA-Challenge-Server für das Redaxo-Modul M20 (Formular).",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Daniel Regeci",
            "email": "536331+ovx@users.noreply.github.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "altcha-org/altcha": "^1.3.3",
        "selective/basepath": "^2.2",
        "slim/slim": "^4.0",
        "slim/psr7": "^1.7",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "AltchaOrg\\AltchaStarterPhp\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "start": "php -S localhost:3000 -t public",
        "selftest": "php bin/selftest.php"
    }
}
